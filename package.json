{
  "name": "@app/social-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:push": "dotenv -e ../../.env -- prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@fastify/static": "^6.0.0",
        "@daccuong-uit/platform-http-common": "^1.0.1",
    "@daccuong-uit/platform-event-bus": "^1.0.0",
    "@daccuong-uit/contracts-events": "^1.0.0",
    "@daccuong-uit/platform-config": "^1.0.0",
    "@daccuong-uit/platform-logger": "^1.0.0",
    "@daccuong-uit/platform-tracing": "^1.0.0",
    "@daccuong-uit/platform-cache": "^1.0.0",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.14.0",
    "typescript": "^5.0.0"
  }
}
